rules_version = '2';
// GradePlanner 보안 규칙 (학년별 자료: 처음 쓰던 학년은 원래 이름, 다른 학년은 컬렉션 이름 앞에 g<학년>__)
//  - 학생 명렬표·쇼핑몰 ID·내선번호 파일·특별실 비밀번호: 비밀번호로 로그인한 사람만 읽고 쓸 수 있음
//  - 비밀번호 사본(gp_secret)·학년 선택(gp_global 쓰기): 관리자만
//  - 그 밖의 시간표·일정 등: 지금처럼 누구나 보고 고칠 수 있음
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == 'gp-admin@gradeplanner-d5499.firebaseapp.com'; }
    function isMember() { return isAdmin() || (request.auth != null && request.auth.token.email == 'gp-access@gradeplanner-d5499.firebaseapp.com'); }
    function isPriv(col) { return col.matches('(g[1-6]__)?(data_student|data_mall|gp_private)'); }
    function isFiles(col) { return col.matches('(g[1-6]__)?data_files'); }
    function isCfg(col) { return col.matches('(g[1-6]__)?app_config'); }

    match /gp_secret/{doc} { allow read, write: if isAdmin(); }
    match /gp_global/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /{col}/{doc} {
      allow read: if col != 'gp_secret' && col != 'gp_global' && (isPriv(col) ? isMember() : (isFiles(col) ? (isMember() || !doc.matches('ext_.*')) : true));
      allow write: if col != 'gp_secret' && col != 'gp_global' && (isPriv(col) ? isMember() : (isFiles(col) ? (isMember() || !doc.matches('ext_.*')) : (isCfg(col) ? (isAdmin() || !(doc in ['security', 'passwords', 'room_passwords'])) : true)));
    }
  }
}
