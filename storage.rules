rules_version = '2';
// 지금은 파일을 Firestore 에 저장하므로 Storage 는 쓰지 않습니다. 예전 이미지 보기만 허용하고, 올리기는 로그인한 사람만.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['gp-admin@gradeplanner-d5499.firebaseapp.com', 'gp-access@gradeplanner-d5499.firebaseapp.com'] && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
